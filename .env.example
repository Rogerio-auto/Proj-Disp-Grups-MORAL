# Database
DATABASE_URL=postgresql://postgres:your_password_here@host.docker.internal:5432/campanhas_db?schema=public

# Authentication
JWT_SECRET=seu_segredo_jwt_aqui

# Admin User (criado automaticamente na inicialização)
ADMIN_EMAIL=admin@sistema.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrador

# Z-API Configuration
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_BASE_URL=https://api.z-api.io

# Server
PORT=3002
NODE_ENV=production
